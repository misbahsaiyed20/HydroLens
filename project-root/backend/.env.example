# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aqua_sentinel

APP_NAME=Aqua Sentinel API
ENVIRONMENT=development
API_PREFIX=/api

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Local image storage (Sprint 1 only)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# Gemini vision analysis (Sprint 2) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Swap this if Google deprecates the model — check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash

# Evidence fusion (Sprint 3)
RELATED_REPORT_RADIUS_METERS=300.0
RELATED_REPORT_TIME_WINDOW_MINUTES=120
BASELINE_MINIMUM_OBSERVATIONS=5
CORROBORATION_SATURATION_COUNT=4
CONFIDENCE_HIGH_THRESHOLD=0.70
CONFIDENCE_MODERATE_THRESHOLD=0.40

# Actionability (Sprint 4)
PRIORITY_REVIEW_MIN_SUPPORTING_COUNT=3

# Authentication — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in any real deployment; never commit the real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
